#!/bin/sh

if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  reference='`/springbrand:ask-springbrand` Plugin Skill (Canonical Skill: `ask-springbrand`)'
else
  reference='`$ask-springbrand` Skill'
fi

printf '%s\n' "{\"hookSpecificOutput\":{\"hookEventName\":\"UserPromptSubmit\",\"additionalContext\":\"SpringBrand is available through the installed ${reference}.\\n\\nIt has three capability domains on one MCP entry:\\n- Platform: create and publish artifacts, manage Plugins, and browse the Marketplace\\n- Action API: use dynamic API services for tasks\\n- Connector: work with third-party systems such as GitHub\\n\\nWhen the right domain is unclear, or you ask what SpringBrand can do, follow ${reference} first; it recommends exactly one Domain Skill and stops.\\n\\nThis Notice only makes the Skills visible. It does not determine fit, call MCP, or cause side effects.\"}}"
